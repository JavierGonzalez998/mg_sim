# Copia este archivo como .env y cambia los valores marcados. No subas .env al repositorio.

# Django
DJANGO_SECRET_KEY=CAMBIA-ESTO-por-una-clave-larga-y-aleatoria
# Dominios desde los que se sirve la app, separados por comas (sin esquema).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Los mismos dominios con esquema y puerto si no es el estándar.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
# 1 si la app se sirve por HTTPS (certificado en nginx o en un balanceador delante): cookies seguras.
DJANGO_HTTPS=0

# MySQL (el contenedor "db" se crea con estos datos la primera vez)
MYSQL_DATABASE=mg_simulator
MYSQL_USER=mg
MYSQL_PASSWORD=CAMBIA-ESTO
MYSQL_ROOT_PASSWORD=CAMBIA-ESTO-TAMBIEN

# Superusuario que se crea al arrancar si no existe (acceso a /manage/ y /admin/). Opcional.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=CAMBIA-ESTO

# Correo SMTP (opcional; la app aún no envía correos). Sin EMAIL_HOST se usa la consola.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=MG Simulator <no-reply@example.com>

# Puerto del host donde nginx publica la app (80 = http://tu-dominio sin puerto).
PUERTO=80
